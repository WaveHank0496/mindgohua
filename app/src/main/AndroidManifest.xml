<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        隱私硬保證（spec §0.2）：本 app 刻意「不」宣告 android.permission.INTERNET。
        系統層級即無法連網 —— 請勿因為任何理由加回來。
        任何新增的第三方函式庫若需要 INTERNET，一律不得引入。
    -->

    <!-- Mode A：讀前景 app 事件流 -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- 疊 overlay 打斷（兩個 Mode 皆需） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 常駐服務 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- ColorOS 殺後台對策：引導使用者放行電池最佳化 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
        讓設定頁能列出使用者可挑選的目標 app。

        原本這裡是一份寫死的白名單（IG / YouTube / TikTok…），代價是
        使用者想看住 Threads、小紅書、Netflix 一律辦不到 —— 名單外的 app
        我們連它裝沒裝都查不到。

        改成宣告「查詢有桌面圖示的 app」。這樣能列出所有使用者實際會開來滑的東西，
        而且**不需要 QUERY_ALL_PACKAGES**（那是 Google Play 列管的敏感權限，
        上架要填表說明用途，核准與否不在我們手上）。

        查不到的只有沒有桌面圖示的系統元件 —— 那些本來就不會有人拿來滑。
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".MindgohuaApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@drawable/ic_launcher_cat"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mindgohua">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Mindgohua">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.GatekeeperService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Continuously observes which app is in the foreground so the user's own screen-time limit can be enforced with an on-screen interruption. No data leaves the device." />
        </service>

        <!--
            Mode B：只監聽 TYPE_VIEW_SCROLLED 的「時間戳」。
            canRetrieveWindowContent 明確設為 false —— 我們不讀節點樹、不讀文字（spec §10）。
        -->
        <service
            android:name=".service.ScrollWatchService"
            android:exported="false"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <receiver
            android:name=".service.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
