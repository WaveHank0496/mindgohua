<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        隱私硬保證（spec §0.2）：本 app 刻意「不」宣告 android.permission.INTERNET。
        系統層級即無法連網 —— 請勿因為任何理由加回來。
        任何新增的第三方函式庫若需要 INTERNET，一律不得引入。

        下面這一行不是宣告，是**強制移除**。

        為什麼需要它：真正打包進 AAB 的是「合併後」的 manifest，而任何第三方
        函式庫都能透過 manifest merger 把 INTERNET 注入進去。原本
        PrivacyInvariantTest 只掃這個原始檔，那種注入它一個字都看不到 ——
        測試會繼續顯示綠燈，而上架的 app 已經可以連網。

        tools:node="remove" 讓 merger 無條件拔掉任何來源的 INTERNET，
        把「靠人自律」換成「靠工具強制」。
    -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />

    <!-- Mode A：讀前景 app 事件流 -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- 疊 overlay 打斷（兩個 Mode 皆需） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 常駐服務 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        這裡原本宣告 REQUEST_IGNORE_BATTERY_OPTIMIZATIONS，用來直接跳出
        「要不要豁免這個 app」的系統對話框。已經刪掉。

        理由：Google Play 對那個權限有一份明確的可接受用途白名單
        （鬧鐘、VoIP、裝置自動化…），「螢幕使用時間管理」不在上面。
        為了省使用者兩次點擊而冒著整個 app 被拒絕的風險，不划算。

        改用免權限的 ACTION_IGNORE_BATTERY_OPTIMIZATION_SETTINGS 清單頁
        （見 Permissions.batteryOptimizationIntent）。查詢豁免狀態用的是
        PowerManager，本來就不需要任何權限，所以設定頁的燈號不受影響。
    -->

    <!--
        讓設定頁能列出使用者可挑選的目標 app。

        原本這裡是一份寫死的白名單（IG / YouTube / TikTok…），代價是
        使用者想看住 Threads、小紅書、Netflix 一律辦不到 —— 名單外的 app
        我們連它裝沒裝都查不到。

        改成宣告「查詢有桌面圖示的 app」。這樣能列出所有使用者實際會開來滑的東西，
        而且**不需要 QUERY_ALL_PACKAGES**（那是 Google Play 列管的敏感權限，
        上架要填表說明用途，核准與否不在我們手上）。

        查不到的只有沒有桌面圖示的系統元件 —— 那些本來就不會有人拿來滑。
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".MindgohuaApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_launcher_cat"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mindgohua">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Mindgohua">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.GatekeeperService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Continuously observes which app is in the foreground so the user's own screen-time limit can be enforced with an on-screen interruption. No data leaves the device." />
        </service>

        <!--
            這裡原本宣告一個 AccessibilityService（Mode B：只讀捲動事件的時間戳，
            canRetrieveWindowContent 明確為 false）。**v1 整個移除。**

            為什麼不是「從 UI 隱藏就好」：Play 掃的是上傳的 AAB 裡的合併後 manifest，
            不是 app 的畫面。只要這個 <service> 宣告還在，就會觸發 Permissions & APIs
            政策的無障礙用途宣告 —— 而那是目前拒絕率最高的類別之一。

            我們的用法其實很乾淨、很好辯護，但那代表要花時間去打一場
            v1 根本不需要打的仗。演算法本身（ScrollRhythmAnalyzer、ItemAdvanceCounter）
            留在原地，未來想做時不必重寫。
        -->

        <receiver
            android:name=".service.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
