<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 11（API 30）用的備份規則。

    為什麼需要這個檔案：專案的 minSdk 是 30，但 android:dataExtractionRules
    只有 Android 12 以上才生效。也就是說，**Android 11 的使用者原本不受
    data_extraction_rules.xml 保護** —— 那份「不備份、不轉移任何資料」的
    承諾在他們的手機上是破的。這是 lint 的 DataExtractionRules 警告在講的事，
    它不是格式問題，是一個真實的隱私缺口。

    android:allowBackup 已經是 false，理論上不會有備份發生；
    這份規則是第二道防線 —— 隱私保證不該只靠單一個布林值撐著。
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
